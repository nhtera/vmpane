// Local builds are ad hoc signed so entitlements (e.g. virtualization) apply when running from Xcode.
// Set DEVELOPMENT_TEAM / CODE_SIGN_IDENTITY in the gitignored Config/Local.xcconfig to sign with a team.
// Release signing for distribution is done by scripts/sign.sh from Config/signing-manifest.json.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
OTHER_CODE_SIGN_FLAGS = --timestamp=none
#include? "Local.xcconfig"
