// Settings shared by every target and configuration.
MACOSX_DEPLOYMENT_TARGET = 15.0
// Apple silicon only: Virtualization features and HVF guests need arm64 hosts.
ARCHS = arm64
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ENABLE_HARDENED_RUNTIME = YES
CURRENT_PROJECT_VERSION = 7
MARKETING_VERSION = 1.0.0-beta.7
DEAD_CODE_STRIPPING = YES
// Sparkle updates (App/Updates/UpdaterController.swift): the appcast and its EdDSA public key, set for Release
// builds (Release.xcconfig). Either empty keeps the updater off: a development build never replaces itself.
VMPANE_SPARKLE_FEED_URL =
VMPANE_SPARKLE_PUBLIC_KEY =
ENABLE_USER_SCRIPT_SANDBOXING = YES
#include "Signing.xcconfig"
