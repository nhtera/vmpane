    { "path": "Contents/Helpers/qemu/bin/qemu-img", "identifier": "app.vmpane.mac.qemu-img", "entitlements": null, "optional": true },
    { "path": "Contents/Helpers/qemu/bin/swtpm", "identifier": "app.vmpane.mac.swtpm", "entitlements": null, "optional": true },
    { "path": "Contents/Helpers/vmpane", "identifier": "app.vmpane.mac.cli", "entitlements": null },
    { "path": "Contents/Helpers/VMPaneVM.app/Contents/MacOS/*.dylib", "identifier": null, "entitlements": null, "optional": true },
    { "path": "Contents/Helpers/VMPaneVM.app/Contents/Frameworks/*.dylib", "identifier": null, "entitlements": null, "optional": true },
    { "path": "Contents/Helpers/VMPaneVM.app", "identifier": "app.vmpane.mac.vm", "entitlements": "Config/Entitlements/VMPaneVM.entitlements" },
    { "path": "Contents/Frameworks/Sparkle.framework/Versions/B/Autoupdate", "identifier": "org.sparkle-project.Sparkle.Autoupdate", "entitlements": null },
