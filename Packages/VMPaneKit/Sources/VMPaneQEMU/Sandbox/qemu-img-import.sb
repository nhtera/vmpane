;; Deny-by-default sandbox for qemu-img converting an imported disk image (Parallels import; QEMUSandbox.swift).
;; The image comes from outside (another Mac, a download): qemu-img parses it with no network and no access
;; beyond its own folder and the new VM's.
;; Parameters (-D):
;;   SOURCE   the folder holding the image (read-only)
;;   TARGET   the folder of the converted disk (read-write)
;;   RUNTIME  the QEMU installation qemu-img runs from (read-only: the program and its libraries)
(version 1)
(deny default)
(debug deny)

(allow process-exec (subpath (param "RUNTIME")))
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.logd")
  (global-name "com.apple.diagnosticd"))
(allow ipc-posix-shm-read-data ipc-posix-shm-read-metadata
  (ipc-posix-name-prefix "apple.shm.notification_center"))

(allow file-read* file-map-executable
  (subpath "/System") (subpath "/usr/lib") (subpath "/Library/Apple")
  (subpath "/private/var/db/dyld") (subpath "/System/Volumes/Preboot/Cryptexes")
  (subpath (param "RUNTIME")))
(allow file-read* (literal "/"))
(allow file-read-metadata (literal "/private") (literal "/private/var") (literal "/Users"))
(allow file-read-metadata (path-ancestors (param "RUNTIME")) (path-ancestors (param "SOURCE")) (path-ancestors (param "TARGET")))
(allow file-read* (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random")
  (literal "/private/etc/localtime") (subpath "/usr/share/zoneinfo") (subpath "/private/var/db/timezone"))
(allow file-write-data (literal "/dev/null"))

(allow file-read* (subpath (param "SOURCE")))
(allow file-read* file-write* (subpath (param "TARGET")))
