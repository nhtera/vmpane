-nodefaults
-no-user-config
-name
Windows 11
-uuid
11111111-2222-4333-8444-555555555555
-machine
virt,highmem=on,gic-version=3
-accel
hvf
-cpu
host
-smp
2
-m
4096M
-L
/runtime/1.0-q12345678/qemu/share/qemu
-display
none
-rtc
base=localtime
-drive
if=pflash,format=raw,readonly=on,file=/run/abcd1234/efi_code.fd
-drive
if=pflash,format=raw,file=<bundle>/current/aux/efi_vars.fd
-device
qemu-xhci,id=xhci
-device
usb-kbd,bus=xhci.0
-device
usb-tablet,bus=xhci.0
-blockdev
node-name=disk0,driver=raw,discard=unmap,file.driver=file,file.filename=<bundle>/current/disk.img
-device
nvme,drive=disk0,serial=vmpane-0,bootindex=0
-device
ramfb
-netdev
user,id=net0,ipv6=off
-device
virtio-net-pci,netdev=net0,mac=52:54:00:ab:cd:ef
-spice
unix=on,addr=/run/abcd1234/spice.sock,disable-ticketing=on,image-compression=off,streaming-video=off
-device
virtio-serial-pci,id=vser
-chardev
spicevmc,id=vdagent,name=vdagent
-device
virtserialport,bus=vser.0,chardev=vdagent,name=com.redhat.spice.0
-chardev
socket,id=agent,path=/run/abcd1234/agent.sock,server=on,wait=off
-device
virtserialport,bus=vser.0,chardev=agent,name=app.vmpane.agent.0
-device
virtio-rng-pci
-device
pvpanic-pci
-qmp
unix:/run/abcd1234/qmp.sock,server=on,wait=off
-incoming
defer
