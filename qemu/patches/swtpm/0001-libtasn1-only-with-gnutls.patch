VMPane patch header (text before the first "---" line is ignored by patch)
Origin: VMPane (written for this build).
Reason: configure requires libtasn1 unconditionally, but only swtpm_cert links it, and swtpm_cert is
  built only with gnutls. VMPane builds --without-gnutls (no swtpm_cert), so the check is skipped then.

--- a/configure.ac	2026-08-19 07:32:30
+++ b/configure.ac	2026-10-10 14:22:23
@@ -172,9 +172,12 @@
 	;;
 esac
 
-LIBTASN1_LIBS=$(pkg-config --libs libtasn1)
-if test $? -ne 0; then
-	AC_MSG_ERROR("Is libtasn1-devel installed? -- could not get libs for libtasn1")
+dnl Only swtpm_cert (built with gnutls) links libtasn1.
+if test "x$with_gnutls" != "xno"; then
+	LIBTASN1_LIBS=$(pkg-config --libs libtasn1)
+	if test $? -ne 0; then
+		AC_MSG_ERROR("Is libtasn1-devel installed? -- could not get libs for libtasn1")
+	fi
 fi
 AC_SUBST([LIBTASN1_LIBS])
 
